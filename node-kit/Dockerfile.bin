# openflux-node from prebuilt linux binaries (no Go toolchain on the server):
# put `openflux`, `ofnode` and `oflink` (GOOS=linux, the node's GOARCH) next to this
# file and build in that folder:
#   docker build -f Dockerfile.bin -t openflux-node:local .
# В Docker Hub (тогда на нодах только compose): sh publish.sh <логин>/openflux-node
FROM alpine:3.22
RUN apk add --no-cache ca-certificates iptables
COPY openflux ofnode oflink /usr/local/bin/
RUN chmod 0755 /usr/local/bin/openflux /usr/local/bin/ofnode /usr/local/bin/oflink
VOLUME /var/lib/openflux-node
ENTRYPOINT ["/usr/local/bin/ofnode", "serve"]
