# Supwave — настройки аугментера. Скопируй в .env и заполни блок «Обязательно».
# ВАЖНО: комментарии — только отдельными строками, как здесь (env_file Docker не
# всегда срезает хвост «# …» после значения).

# ── Обязательно ─────────────────────────────────────────────────────────────
# API Remnawave. Внутренний http://remnawave:3000 у части панелей рвёт соединение —
# тогда публичный адрес панели.
REMNAWAVE_API_URL=https://panel.example.com
# Токен API Remnawave: панель → Settings → API Tokens.
REMNAWAVE_API_TOKEN=
# Токен входа в веб-морду: длинный случайный (openssl rand -hex 32).
ADMIN_TOKEN=
# Домен панели — только на нём отвечает веб-морда (на домене подписки её нет).
ADMIN_HOSTS=panel.example.com
# Публичный IP сервера панели — подставится в команду ufw для новых нод.
PANEL_IP=

# ── Обычно не трогать ────────────────────────────────────────────────────────
# Страница подписки Remnawave, которую аугментер отдаёт (дописывая openflux).
SUB_UPSTREAM=http://remnawave-subscription-page:3010
# Где веб-морда и её API: https://panel.<домен>/augmenter/ (маршрут в Caddy — README).
ADMIN_PREFIX=/augmenter
# real — заводить каналы на нодах; stub — демо-ссылки без нод.
PROVISION_MODE=real
# on — сверка сама заводит и снимает каналы; dryrun — только пишет в журнал; off — выключена.
RECONCILE_MODE=on
# Секунд между сверками (и сразу при старте).
RECONCILE_INTERVAL=600
# Образ ноды, который попадает в compose из «Добавить ноду».
OPENFLUX_NODE_IMAGE=trueheck/openflux-node:latest
# Режим выхода на ноде: l3 (быстрее; compose ноды даёт нужный NET_ADMIN) | l4 (gVisor).
OPENFLUX_NODE_MODE=l3
# Носители канала: доска — основной, волга — запасной. Трафик идёт через живой
# носитель с наивысшим приоритетом.
OPENFLUX_PRIORITIES=boards:70,vyandex:50
# Сколько каналов держать на одном аккаунте Яндекса (0 — без лимита): размазывает
# создание досок и документов, чтобы Яндекс не прижал аккаунт.
POOL_MAX_DOCS_PER_ACCOUNT=40
# Таймаут создания одной доски/документа, сек.
WIZARD_TIMEOUT=150
STORE_PATH=/data/links.db

# ── Умолчания для вкладки «Настройки» ────────────────────────────────────────
# В морде правятся без перезапуска; эти значения — только пока там ничего не сохранено.
# Кому openflux: сквады Remnawave (имя или uuid через запятую), * — всем активным,
# пусто — никому, пока не выберешь сквады в морде.
TARGET_SQUADS=
# Клиенты (метки User-Agent), которым дописывать openflux. Голую «Happ» не ставить —
# тогда openflux получат все Happ (Rawline шлёт «Happ/3.0 RawlineMobile/…» → метка Rawline).
POD_UA_MARKER=AVACA-Pod,Rawline
# Имя openflux-профиля в приложении ({node} — имя ноды); пусто — имя канала.
OPENFLUX_LINK_NAME=
# Название в шапке морды (первые три буквы — голубые).
BRAND_NAME=Supwave

# ── Редко ────────────────────────────────────────────────────────────────────
# direct — прямой носитель на открытый порт ноды. Выключен: россыпь открытых
# нестандартных портов выдаёт ноду ТСПУ. on — включить (тогда открыть PORT_RANGE).
OPENFLUX_DIRECT=off
OPENFLUX_NODE_PORT_RANGE=20000-29999
# Общие доска/документ, пока пул аккаунтов пуст (обычно не нужны — пул создаёт свои).
OPENFLUX_BOARDS_DOC=
OPENFLUX_VOLGA_DOC=
OPENFLUX_YANDEX_COOKIES=
# Одна общая openflux-ссылка всем (режим MVP без своих каналов) — оставь пустой.
OPENFLUX_LINE=
# Старый путь по SSH (node-install.sh) — только с OPENFLUX_DIRECT=on и без нод-агентов.
OPENFLUX_NODES=
SSH_KEY=/keys/openflux
SSH_PORT=22
